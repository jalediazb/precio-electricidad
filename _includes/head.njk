<!DOCTYPE html><html lang="{{config.site.html_language}}" data-theme="light" class="has-navbar-fixed-bottom">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bulma@1.0.4/css/bulma.min.css">
<link rel="stylesheet" href="//cdn.jsdelivr.net/chartist.js/latest/chartist.min.css">
<link rel="stylesheet" href="/_includes/style.css">
        <script src="//cdn.jsdelivr.net/chartist.js/latest/chartist.min.js"></script>
        <title>{{ title }}</title>
        <meta name="description" content="{{ meta_description }}">
        <meta name="author" content="{{ author or config.site.author }}">
        <link rel="icon" href='{{ config.site.favicon }}' type="image/png" sizes="32x32">

        {% if robots %}
        <meta name="robots" content="{{ robots }}">
        {% endif %}


        {# Canonical #}

        {% if layout in ['page', 'index'] %}
            <link rel="canonical" href="https://{{ config.site.domain }}{{ page.url }}">
        {% endif %}

        <script type="application/ld+json">
        {
            "@context": "https://schema.org",
            "@type": "WebPage",
            "name": "{{ title }}",
            "description": "{{ meta_description }}",
            "url": "https://{{ config.site.domain }}{{ page.url }}",
            "inLanguage": "{{ config.site.html_language }}",
            "isPartOf": {
                "@type": "WebSite",
                "name": "{{ config.site.title }}",
                "url": "https://{{ config.site.domain }}/"
            }
        }
        </script>

        {% if layout == 'index' %}
        <script type="application/ld+json">
        {
            "@context": "https://schema.org",
            "@type": "Organization",
            "name": "{{ config.site.title }}",
            "url": "https://{{ config.site.domain }}/",
            "logo": "https://{{ config.site.domain }}/_includes/img/electON.png",
            "email": "{{ config.site.email }}",
            "description": "Información independiente sobre el precio de la luz en España, el mercado regulado (PVPC) y el ahorro eléctrico en el hogar."
        }
        </script>
        <script type="application/ld+json">
        {
            "@context": "https://schema.org",
            "@type": "WebSite",
            "name": "{{ config.site.title }}",
            "url": "https://{{ config.site.domain }}/"
        }
        </script>
        {% endif %}

        <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-3360355213948178" crossorigin="anonymous"></script>

        <!-- Open Graph / Facebook -->
        <meta property="og:type" content="{% if layout == 'page' %}article{% else %}website{% endif %}">
        <meta property="og:url" content="https://{{config.site.domain}}{{ page.url }}">
        <meta property="og:title" content="{{ title }}">
        <meta property="og:description" content="{{ meta_description }}">
        {% if og_image %}
        <meta property="og:image" content="https://{{config.site.domain}}{{ og_image }}">
        {% else %}
        <meta property="og:image" content="https://{{config.site.domain}}/img/comprar-precio-electricidad-espana.jpg">
        {% endif %}
        <meta property="og:image:width" content="1200">
        <meta property="og:image:height" content="630">
        <meta property="og:locale" content="{{config.site.language }}">
        <meta property="og:site_name" content="{{config.site.title}}">
        {% if layout == 'page' %}
        <meta property="article:published_time" content="{{ date | isoDate }}">
        <meta property="article:modified_time" content="{{ (updated or date) | isoDate }}">
        {% endif %}

        <!-- Twitter -->
        <meta property="twitter:card" content="summary_large_image">
        <meta property="twitter:url" content="https://{{config.site.domain}}{{ page.url }}">
        <meta property="twitter:title" content="{{ title }}">
        <meta property="twitter:description" content="{{ meta_description }}">
        {% if og_image %}
        <meta property="twitter:image" content="https://{{config.site.domain}}{{ og_image }}">
        {% else %}
        <meta property="twitter:image" content="https://{{config.site.domain}}/img/comprar-precio-electricidad-espana.jpg">
        {% endif %}
    </head>
    <body>
