---
title: Precio Electricidad
---

{% include "_includes/head.njk" %}
{% include "_includes/header.njk" %}
<main>
    <!-- Hero Section -->
    <section class="hero-new">
        <div class="hero-new-container">
            <div class="hero-new-content">
                <div class="hero-badge">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
                    Datos actualizados
                </div>
                <h1 class="hero-title">Precio de la Luz Hoy en España</h1>
                <p class="hero-subtitle">Consulta el precio de la electricidad por horas en el mercado regulado (PVPC). Ahorra hasta un 40% en tu factura programando tus electrodomésticos en las horas más baratas.</p>
                <div class="hero-date">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                    <span class="date-text">{{ precios.fecha }}</span>
                </div>
            </div>
        </div>
    </section>

    <!-- Chart and Quick Facts Layout -->
    <section class="chart-section">
        <div class="container">
            <div class="chart-layout">
                <!-- Main Column: Chart -->
                <div class="chart-main">
                    <div class="chart-card">
                        <header class="chart-header">
                            <h2 class="chart-title">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
                                Evolución horaria del precio PVPC
                            </h2>
                            <span class="chart-subtitle">Precio del kWh por hora del día</span>
                        </header>
                        <div class="chart-body">
                            <div class="ct-chart ct-perfect-fourth"></div>
                        </div>
                    </div>
                </div>

                <!-- Sidebar: Quick Facts -->
                <div class="chart-sidebar">
                    <div class="quick-facts-panel">
                        <h3 class="quick-facts-title">Datos clave de hoy</h3>
                        
                        <div class="quick-fact-box cheap">
                            <div class="quick-fact-header">
                                <div class="quick-fact-icon">
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
                                </div>
                                <span class="quick-fact-label">Hora más barata</span>
                            </div>
                            <div class="quick-fact-value" id="fact-cheapest-hour">--</div>
                            <div class="quick-fact-hint">Ideal para lavadora y lavavajillas</div>
                        </div>

                        <div class="quick-fact-box expensive">
                            <div class="quick-fact-header">
                                <div class="quick-fact-icon">
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                                </div>
                                <span class="quick-fact-label">Hora más cara</span>
                            </div>
                            <div class="quick-fact-value" id="fact-expensive-hour">--</div>
                            <div class="quick-fact-hint">Evita electrodomésticos</div>
                        </div>

                        <div class="quick-fact-box average">
                            <div class="quick-fact-header">
                                <div class="quick-fact-icon">
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
                                </div>
                                <span class="quick-fact-label">Precio medio</span>
                            </div>
                            <div class="quick-fact-value" id="fact-average-price">--</div>
                            <div class="quick-fact-hint">Referencia del día</div>
                        </div>

                        <a href="/horas-mas-baratas-luz-hoy/" class="quick-facts-cta">
                            Ver horas más baratas
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Time Slots Bar -->
    <div id="contenedor-franjas"></div>

    <!-- Main Content -->
    <section class="content-section-main">
        <div class="container content is-medium home-content">
            {{ content | safe }}
        </div>
    </section>

    {% if collections.actualidad and collections.actualidad.length %}
    <!-- Últimos análisis -->
    <section class="content-section-main">
        <div class="container content is-medium">
            <h2>Últimos análisis</h2>
            <div class="actualidad-list">
                {% for post in collections.actualidad | reverse %}
                <article class="actualidad-item">
                    <p class="actualidad-item-date">{{ post.data.date | euDate }}</p>
                    <h3 class="actualidad-item-title"><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
                    <p class="actualidad-item-desc">{{ post.data.meta_description }}</p>
                </article>
                {% endfor %}
            </div>
            <p><a href="/actualidad/" class="feature-link">Ver toda la actualidad →</a></p>
        </div>
    </section>
    {% endif %}
</main>
{% include "_includes/footer.njk" %}
