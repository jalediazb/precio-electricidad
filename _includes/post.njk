---
---
{% include "_includes/head.njk" %}
{% include "_includes/header.njk" %}
<main>
    <!-- Hero del post -->
    <section class="article-hero">
        <div class="article-hero-container">
            <div class="article-hero-content">
                <nav class="article-breadcrumb" aria-label="breadcrumbs">
                    <ul>
                        <li><a href="/">Inicio</a></li>
                        <li><a href="/actualidad/">Actualidad</a></li>
                        <li class="is-active"><span aria-current="page">{{ title }}</span></li>
                    </ul>
                </nav>
                <h1 class="article-hero-title">{{ title }}</h1>
                {% if meta_description %}
                <p class="article-hero-subtitle">{{ meta_description }}</p>
                {% endif %}
                <div class="article-meta">
                    <span>Por <strong>{{ author or config.site.author }}</strong></span>
                    <span class="article-meta-sep">·</span>
                    {% if updated and (updated | isoDate) != (date | isoDate) %}
                    <span>Publicado el {{ date | isoDate }}</span>
                    <span class="article-meta-sep">·</span>
                    <span>Actualizado el {{ updated | isoDate }}</span>
                    {% else %}
                    <span>Actualizado el {{ (updated or date) | isoDate }}</span>
                    {% endif %}
                </div>
            </div>
        </div>
    </section>

    <!-- Contenido del post -->
    <section class="article-section">
        <div class="article-container">
            <article class="article-card">
                <div class="article-content">
                    {{ content | safe }}
                </div>

                <div class="article-author">
                    <div class="article-author-avatar" aria-hidden="true">⚡</div>
                    <div>
                        <p class="article-author-name">{{ author or config.site.author }}</p>
                        <p class="article-author-bio">Análisis elaborado por el equipo editorial de ElectON a partir de fuentes oficiales (REE/ESIOS, OMIE, CNMC, IDAE y OCU). Consulta nuestra <a href="/metodologia-y-fuentes/">metodología y fuentes</a>.</p>
                    </div>
                </div>

                {% if related_links %}
                <div class="article-related">
                    <h3>Artículos relacionados</h3>
                    <ul>
                        {% for link in related_links %}
                        <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                        {% endfor %}
                    </ul>
                </div>
                {% endif %}
            </article>

            <aside class="article-sidebar">
                <div class="sidebar-widget">
                    <h3>Actualidad</h3>
                    <ul>
                        {% for post in collections.actualidad | reverse %}
                        {% if post.url != page.url %}
                        <li><a href="{{ post.url }}">{{ post.data.title }}</a></li>
                        {% endif %}
                        {% endfor %}
                    </ul>
                    <p><a href="/actualidad/">Ver toda la actualidad →</a></p>
                </div>

                <div class="sidebar-widget highlight">
                    <h3>Precio de hoy</h3>
                    <p>Consulta el precio de la luz por horas y las horas más baratas del día.</p>
                    <a href="/" class="sidebar-cta">
                        Ver precio de hoy
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                    </a>
                </div>
            </aside>
        </div>
    </section>
</main>

<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": {{ title | dump | safe }},
    "description": {{ meta_description | dump | safe }},
    "url": "https://{{ config.site.domain }}{{ page.url }}",
    "datePublished": "{{ date | isoDate }}",
    "dateModified": "{{ (updated or date) | isoDate }}",
    "inLanguage": "{{ config.site.html_language }}",
    "image": "https://{{ config.site.domain }}{{ og_image or '/img/comprar-precio-electricidad-espana.jpg' }}",
    "author": {
        "@type": "Organization",
        "name": "{{ author or config.site.author }}",
        "url": "https://{{ config.site.domain }}/sobre-nosotros/"
    },
    "publisher": {
        "@type": "Organization",
        "name": "{{ config.site.title }}",
        "logo": {
            "@type": "ImageObject",
            "url": "https://{{ config.site.domain }}/_includes/img/electON.png"
        }
    },
    "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "https://{{ config.site.domain }}{{ page.url }}"
    }
}
</script>

<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
        {
            "@type": "ListItem",
            "position": 1,
            "name": "Inicio",
            "item": "https://electon.es/"
        },
        {
            "@type": "ListItem",
            "position": 2,
            "name": "Actualidad",
            "item": "https://electon.es/actualidad/"
        },
        {
            "@type": "ListItem",
            "position": 3,
            "name": "{{ title }}",
            "item": "https://electon.es{{ page.url }}"
        }
    ]
}
</script>

{% include "_includes/footer.njk" %}
