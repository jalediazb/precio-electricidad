    "name": "Actualidad | {{ config.site.title }}",
    "url": "https://{{ config.site.domain }}/actualidad/",
    "description": "Análisis y actualidad sobre el precio de la luz en España.",
    "inLanguage": "{{ config.site.html_language }}",
